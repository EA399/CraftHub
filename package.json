{
  "name": "crafthub",
  "version": "2.1.0",
  "description": "Minecraft instance manager and Modrinth browser for desktop",
  "main": "main.js",
  "author": "EA399",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.crafthub.desktop",
    "productName": "CraftHub",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "README.md", "LICENSE", "package.json"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "CraftHub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CraftHub"
    }
  }
}