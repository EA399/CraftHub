{
  "name": "crafthub-launcher",
  "version": "0.1.0",
  "description": "CraftHub – Minecraft Launcher",
  "main": "src/main.js",
  "author": "CraftHub",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "de.crafthub.launcher",
    "productName": "CraftHub",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CraftHub-Setup.${ext}"
    },
    "publish": [{ "provider": "github" }]
  }
}
