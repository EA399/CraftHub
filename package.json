{
  "name": "crafthub",
  "version": "2.0.0",
  "description": "A modern Minecraft mod discovery desktop client powered by Modrinth.",
  "main": "main.js",
  "author": "EA399",
  "license": "MIT",
  "private": true,

"scripts": {
  "start": "electron .",
  "dist": "electron-builder --publish never",
  "build:win": "electron-builder --win nsis --publish never",
  "build:linux": "electron-builder --linux AppImage --publish never",
  "build:mac": "electron-builder --mac dmg --publish never"
},

  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.crafthub.desktop",
    "productName": "CraftHub",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "index.html",
      "README.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "CraftHub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CraftHub"
    },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"], "category": "Game" }
  }
}
